# Copy to .env then fill in, or run:  python jev_mcp.py --configure
# .env is git-ignored. Never commit real keys.

# Required - drives every TypeSafe/Jev decision.
TYPESAFE_API_KEY=

# Required for TYPE_TEXT (typing into fields). Any OpenAI-compatible provider works.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
TEXT_MODEL=deepseek-v4-flash
TEXT_MODEL_REASONING=none

# Optional - blank auto-detects a Chromium-based browser:
# Chrome, Thorium, Chromium, Brave, Edge, Vivaldi, Opera.
JEV_CHROME=

# Optional overrides.
# JEV_DEBUG_PORT=9222
# JEV_CHROME_PROFILE=
# JEV_CHROME_PROFILE_HOME=

# Optional - isolated profile that never sees your normal browsing session.
# Profile isolation, not an OS sandbox. Reset it with: python jev_mcp.py --wipe-sandbox
# JEV_SANDBOX=1

# Optional cost rates. TypeSafe bills input tokens only at $0.042/MTok (output is free).
# JEV_TYPESAFE_PRICE_PER_MTOK_INPUT=0.042
# JEV_TEXT_PRICE_PROMPT_PER_M=0
# JEV_TEXT_PRICE_COMPLETION_PER_M=0
